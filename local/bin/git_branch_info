#!/bin/bash
# Shows a list of branches matching the ref patterns given as the first parameter (usually something like
# "refs/heads" or "refs/heads refs/remotes"). Multiple patterns may be passed as a single space separated
# argument. Avoid a bare "refs", since that also pulls in refs/tags.
# May be used with the following options as the second parameter (will only accept one of the following):
#  * -c: non-color - strips color from the output (useful for pipeing into other commands)
#  * -s: select - puts your into a mode to select a branch out of the output (automatically change to that branch)
#  * -v: verbose - after it finishes listing the branches it will show you the file change differences

# bash counts bytes rather than characters when it pads a %-Ns field, so a name with a multi-byte
# character in it (e.g. "ü") comes up a column short. ${#str} does count characters, so
# we can widen the field by the difference and let printf pad the rest out normally.
byte_length () {
	local LC_ALL=C
	printf '%s' "${#1}"
}

pad_field () {
	local str="${1}" width="${2}" bytes
	bytes="$(byte_length "${str}")"
	printf "%-*s" "$((width + bytes - ${#str}))" "${str}"
}

format_git_branches () {
	if [[ $(uname -a) == *"Darwin"* ]]; then
		SED_EXE='gsed'
	else
		SED_EXE='sed'
	fi
	RED=$(tput setaf 1)
	BLUE=$(tput setaf 4)
	BOLD_WHITE=$(tput bold; tput setaf 7)
	RESET=$(tput sgr0)
	BOLD_RED=$(tput bold; tput setaf 1)
	GREEN=$(tput setaf 2)
	local mystr branch_name not_merged
	local fmt="fullref=%(refname); ref=%(refname:short); authordate=%(authordate:relative); commiterdate=%(committerdate); authorname=%(authorname); sha1=%(objectname);"
	not_merged="$(git branch --no-merge)"
	echo -e "==========================================Branches================================================"
	local -i count=1
	local -a branches branch_refs
	# We want word splitting here so that a caller can pass several ref patterns in a single argument
	# shellcheck disable=SC2206
	local -a patterns=(${1})
	# Remote HEAD symrefs (refs/remotes/<remote>/HEAD) just point at a remote's default branch and render as a
	# bare remote name, so we drop them below before the row limit rather than after
	while read -r entry; do
		eval "${entry}"
		local nomerge="" files_changed=""
		# $fullref $ref $authordate and $authorname are actually set by the eval above, format of "git for-each-ref" is:
		# fullref="refs/heads/master"; ref="master"; authordate="25 hours ago"; commiterdate="Tue Feb 19 12:04:02 2019 -0600"; authorname="<auther_name>"; sha1="e132403f6cd07d2e12874a4c6f0b31a4d8d3637d";
		# shellcheck disable=SC2154
		branches+=("${ref}")
		# shellcheck disable=SC2154
		branch_refs+=("${fullref}")
		# git branch --no-merge only ever reports local branches, so we don't try to flag remote ones
		if [[ "${fullref}" == refs/heads/* ]] && grep -q -e "^[ *]*${ref}[ ]*$" <<<"${not_merged}"; then
			nomerge="(*)"
		fi
		if [[ "${2}" && "${2}" == "-s" ]]; then
			printf "${BOLD_RED}[%3i]${RESET} " $((count++))
		fi
		if [[ "${2}" && "${2}" == "-c" ]]; then
			# shellcheck disable=SC2154
			pad_field "${authordate}" 30
			# shellcheck disable=SC2154
			pad_field "${authorname}" 25
			# shellcheck disable=SC2154
			printf "%s%s\\n" "${ref}" "${nomerge}"
		else
			printf "%s%s%s" "${BLUE}" "$(pad_field "${authordate}" 30)" "${RESET}"
			printf "%s%s%s" "${RED}" "$(pad_field "${authorname}" 25)" "${RESET}"
			printf "${BOLD_WHITE}%s${RESET}${BOLD_RED}%s${RESET}\\n" "${ref}" "${nomerge}"
		fi
		if [[ "${2}" && "${2}" == "-v" ]]; then
			files_changed="$(git log "${ref}" --not --remotes=*/master --stat --pretty="format:" | grep '|')"
			mystr="${mystr}$(printf "%s%s%s:\\n " "${RED}" "${ref}" "${RESET}")"
			while read -r file_lines; do
				file_part1="${file_lines%|*}"
				file_part2="${file_lines##*|}"
				file_part1="$("${SED_EXE}" -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<< "${file_part1}")"
				file_part2="$("${SED_EXE}" -r "s/(\\+*)(-*)/${GREEN}\\1${RESET}${RED}\\2${RESET}/g" <<< "${file_part2}")"
				mystr="${mystr}$(printf "	%s%s%s -%s\\n " "${BOLD_WHITE}" "$(pad_field "${file_part1}" 60)" "${RESET}" "${file_part2}")"
			done <<< "${files_changed}"
		fi
	done <<<"$(git for-each-ref --tcl --sort=-committerdate --format="${fmt}" "${patterns[@]}" |
		grep -v 'fullref="refs/remotes/[^"]*/HEAD"' | head -n 35)"

	if [[ "${2}" && "${2}" == "-s" ]]; then
		printf "\\n%sSelect Branch to Switch to (q to quit): %s" "${BOLD_WHITE}" "${RESET}"
		read -r uinput
		if [[ "${uinput}" == "q" ]]; then
			exit 0
		fi
		if ! [[ ${uinput} =~ ^[0-9]+$ && "$((uinput - 1))" -lt "${#branches[@]}" ]]; then
			echo "Could not validate input"
			exit 1
		fi
		# For a remote-tracking ref, strip the remote name and switch to the local branch instead if we have one.
		# We check the full refname rather than looking for a slash, because plenty of local branches are
		# namespaced (feat/foo, issues/1234) and we'd otherwise mangle those.
		branch_name="${branches[$((uinput - 1))]}"
		if [[ "${branch_refs[$((uinput - 1))]}" == refs/remotes/* ]]; then
			if git rev-parse --verify --quiet "${branch_name#*/}" >/dev/null; then
				branch_name="${branch_name#*/}"
			fi
		fi
		echo "Switching to: ${branch_name}"
		git co "${branch_name}"
	fi

	if [[ "${2}" && "${2}" == "-v" ]]; then
		echo -e "\\n========================================File Changes=============================================="
		echo -e "${mystr}"
	fi
}

format_git_branches "$@"

# vim: set noet sw=4 ts=4:
