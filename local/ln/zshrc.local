# OS Specific Settings {{{
if [[ "${OSTYPE}" == *"darwin"* ]]; then
	SED_OPTS='-E'
else
	SED_OPTS='-r'
fi
# }}}

# Variable and Option Settings {{{
# Don't log to history if the command is prepended with a space
setopt histignorespace

# Shared command history
#setopt inc_append_history # Not needed because it's already in the parent zshrc, but leaving here for completeness
setopt share_history

# Increase History size, to be gigantic
HISTSIZE=32768
SAVEHIST=32768

# Always use less with -FR mode to ensure that applications like git don't use -FRX which won't open less in an
# alternate screen. When it is opened in the primary screen it breaks tmux pgup functionality.
export LESS="-FR"

# Include TTY for GPG
export GPG_TTY="$(tty)"

# Disable command hashing to keep from running "hash -r" all the time
setopt nohashcmds

# }}}

# ZSH Prompt Setup {{{
# Changes prompt to include information about Git repos and what zvim mode we're in

# Git Status via gitstatusd {{{
# Git information comes from gitstatusd (https://github.com/romkatv/gitstatus), a daemon that we start once per shell
# and then query on every prompt, which is quite a bit faster than shelling out to git and python like we used to. The
# binaries are built statically by tools_to_update.sh and named by kernel and arch, so we pick the right one here.
_gitstatus_dir="${HOME}/dotfiles/local/lib/gitstatus"
if [[ "${OSTYPE}" == *"darwin"* ]]; then
	_gitstatus_os="darwin"
else
	_gitstatus_os="linux"
fi
# Linux calls it aarch64 and macOS calls it arm64, which is what uname -m (and therefore the build) reports on each
case "${CPUTYPE}" in
	x86_64|amd64)
		_gitstatus_arch="x86_64"
		;;
	aarch64|arm64)
		[[ "${_gitstatus_os}" == "darwin" ]] && _gitstatus_arch="arm64" || _gitstatus_arch="aarch64"
		;;
	*)
		_gitstatus_arch="${CPUTYPE}"
		;;
esac
GITSTATUS_DAEMON="${_gitstatus_dir}/gitstatusd-${_gitstatus_os}-${_gitstatus_arch}"
# Never let the plugin download a binary behind our back, we only ever want to run the ones we built ourselves
GITSTATUS_AUTO_INSTALL=0

if [[ -x "${GITSTATUS_DAEMON}" ]]; then
	source "${_gitstatus_dir}/gitstatus.plugin.zsh"
	# The -1 values turn on real counts for staged, unstaged, conflicted, and untracked instead of just 0/1 flags
	gitstatus_stop 'PROMPT' && gitstatus_start -s -1 -u -1 -c -1 -d -1 'PROMPT'
else
	print -u2 "gitstatusd binary not found at ${GITSTATUS_DAEMON}, git info will be missing from the prompt"
fi
unset _gitstatus_dir _gitstatus_os _gitstatus_arch

# The theme is identical to magicmonty/bash-git-prompt, carried over from the zsh-git-prompt days
ZSH_THEME_GIT_PROMPT_PREFIX="["
ZSH_THEME_GIT_PROMPT_SUFFIX="]"
ZSH_THEME_GIT_PROMPT_HASH_PREFIX=":"
ZSH_THEME_GIT_PROMPT_SEPARATOR="|"
ZSH_THEME_GIT_PROMPT_BRANCH="%{$fg_bold[magenta]%}"
ZSH_THEME_GIT_PROMPT_STAGED="%{$fg[red]%}%{●%G%}"
ZSH_THEME_GIT_PROMPT_CONFLICTS="%{$fg[red]%}%{✖%G%}"
ZSH_THEME_GIT_PROMPT_CHANGED="%{$fg[blue]%}%{✚%G%}"
ZSH_THEME_GIT_PROMPT_BEHIND="%{↓%2G%}"
ZSH_THEME_GIT_PROMPT_AHEAD="%{↑%2G%}"
ZSH_THEME_GIT_PROMPT_STASHED="%{$fg_bold[blue]%}%{⚑ %G%}"
ZSH_THEME_GIT_PROMPT_UNTRACKED="%{$fg[cyan]%}%{…%G%}"
ZSH_THEME_GIT_PROMPT_CLEAN="%{$fg_bold[green]%}%{✔%G%}"
ZSH_THEME_GIT_PROMPT_LOCAL=" L"
# The remote branch will be shown between these two
ZSH_THEME_GIT_PROMPT_UPSTREAM_FRONT="{%{$fg[blue]%}"
ZSH_THEME_GIT_PROMPT_UPSTREAM_END="%{${reset_color}%}}"
ZSH_THEME_GIT_PROMPT_MERGING="%{$fg_bold[magenta]%}|MERGING%{${reset_color}%}"
ZSH_THEME_GIT_PROMPT_REBASE="%{$fg_bold[magenta]%}|REBASE%{${reset_color}%} "
ZSH_THEME_GIT_PROMPT_ACTION="%{$fg_bold[magenta]%}|"
# 0 never shows the upstream, 1 shows remote/branch, 2 shows just the remote when the branch names match
ZSH_GIT_PROMPT_SHOW_UPSTREAM=2

# Runs before every prompt and fills GIT_PROMPT_STATUS with the formatted git segment (empty outside of a repo). We do
# this in a precmd hook rather than $(...) in PROMPT so that gitstatus_query runs in this shell and we don't fork.
git_prompt_update() {
	emulate -L zsh
	typeset -g GIT_PROMPT_STATUS=''

	# Ask the daemon about $PWD and bail (leaving the segment empty) if it isn't running or we're not in a repo
	gitstatus_query 'PROMPT' || return 0
	[[ "${VCS_STATUS_RESULT}" == 'ok-sync' ]] || return 0

	local branch upstream git_status clean=1

	# Detached HEAD shows the hash prefixed with ':' like the old prompt did. Branch names can contain % so we escape it
	if [[ -n "${VCS_STATUS_LOCAL_BRANCH}" ]]; then
		branch="${VCS_STATUS_LOCAL_BRANCH//\%/%%}"
	else
		branch="${ZSH_THEME_GIT_PROMPT_HASH_PREFIX}${VCS_STATUS_COMMIT[1,7]}"
	fi
	git_status="${ZSH_THEME_GIT_PROMPT_PREFIX}${ZSH_THEME_GIT_PROMPT_BRANCH}${branch}%{${reset_color}%}"

	# During a rebase the action looks like "rebase-i 2/5", so we keep the progress and show it like the old prompt did
	case "${VCS_STATUS_ACTION}" in
		'')
			;;
		rebase*|am*)
			git_status+="${ZSH_THEME_GIT_PROMPT_REBASE}${VCS_STATUS_ACTION[(w)2]}"
			;;
		merge)
			git_status+="${ZSH_THEME_GIT_PROMPT_MERGING}"
			;;
		*)
			# cherry, revert, and bisect didn't show in the old prompt but are worth knowing about
			git_status+="${ZSH_THEME_GIT_PROMPT_ACTION}${(U)VCS_STATUS_ACTION}%{${reset_color}%}"
			;;
	esac

	# Branch with no upstream gets " L", otherwise show the upstream in braces unless it's the boring default
	if [[ -n "${VCS_STATUS_LOCAL_BRANCH}" && -z "${VCS_STATUS_REMOTE_BRANCH}" ]]; then
		git_status+="${ZSH_THEME_GIT_PROMPT_LOCAL}%{${reset_color}%}"
	elif (( ZSH_GIT_PROMPT_SHOW_UPSTREAM > 0 )) && [[ -n "${VCS_STATUS_REMOTE_BRANCH}" ]]; then
		upstream="${VCS_STATUS_REMOTE_NAME}/${VCS_STATUS_REMOTE_BRANCH}"
		# origin/master and origin/main are what you'd assume anyway, so we don't clutter the prompt with them
		if [[ "${upstream}" != "origin/master" && "${upstream}" != "origin/main" ]]; then
			# When the remote branch has the same name as ours, just the remote name is enough (e.g. {origin})
			if (( ZSH_GIT_PROMPT_SHOW_UPSTREAM == 2 )) && [[ "${VCS_STATUS_REMOTE_BRANCH}" == "${VCS_STATUS_LOCAL_BRANCH}" ]]; then
				upstream="${VCS_STATUS_REMOTE_NAME}"
			fi
			git_status+="${ZSH_THEME_GIT_PROMPT_UPSTREAM_FRONT}${upstream//\%/%%}${ZSH_THEME_GIT_PROMPT_UPSTREAM_END}%{${reset_color}%}"
		fi
	fi

	# Ahead / behind the upstream, e.g. " ↓1↑3", with the leading space only when there's something to show
	if (( VCS_STATUS_COMMITS_BEHIND || VCS_STATUS_COMMITS_AHEAD )); then
		git_status+=" "
	fi
	if (( VCS_STATUS_COMMITS_BEHIND )); then
		git_status+="${ZSH_THEME_GIT_PROMPT_BEHIND}${VCS_STATUS_COMMITS_BEHIND}%{${reset_color}%}"
	fi
	if (( VCS_STATUS_COMMITS_AHEAD )); then
		git_status+="${ZSH_THEME_GIT_PROMPT_AHEAD}${VCS_STATUS_COMMITS_AHEAD}%{${reset_color}%}"
	fi

	git_status+="${ZSH_THEME_GIT_PROMPT_SEPARATOR}"

	# Everything after the separator is working tree state, each counter only appears when it's non-zero
	if (( VCS_STATUS_NUM_STAGED )); then
		git_status+="${ZSH_THEME_GIT_PROMPT_STAGED}${VCS_STATUS_NUM_STAGED}%{${reset_color}%}"
		clean=0
	fi
	if (( VCS_STATUS_NUM_CONFLICTED )); then
		git_status+="${ZSH_THEME_GIT_PROMPT_CONFLICTS}${VCS_STATUS_NUM_CONFLICTED}%{${reset_color}%}"
		clean=0
	fi
	if (( VCS_STATUS_NUM_UNSTAGED )); then
		git_status+="${ZSH_THEME_GIT_PROMPT_CHANGED}${VCS_STATUS_NUM_UNSTAGED}%{${reset_color}%}"
		clean=0
	fi
	if (( VCS_STATUS_NUM_UNTRACKED )); then
		git_status+="${ZSH_THEME_GIT_PROMPT_UNTRACKED}${VCS_STATUS_NUM_UNTRACKED}%{${reset_color}%}"
		clean=0
	fi
	# Stashes count as not clean, which is how the old prompt behaved too
	if (( VCS_STATUS_STASHES )); then
		git_status+="${ZSH_THEME_GIT_PROMPT_STASHED}${VCS_STATUS_STASHES}%{${reset_color}%}"
		clean=0
	fi
	# Nothing above fired, so show the green check mark
	if (( clean )); then
		git_status+="${ZSH_THEME_GIT_PROMPT_CLEAN}%{${reset_color}%}"
	fi

	GIT_PROMPT_STATUS="%{${reset_color}%}${git_status}${ZSH_THEME_GIT_PROMPT_SUFFIX}%{${reset_color}%}"
}

# zsh runs every function in its precmd hook array right before it draws a prompt (after the previous command exits, and
# again on each empty enter), so hooking git_prompt_update here means GIT_PROMPT_STATUS is always fresh by the time
# PROMPT gets expanded. gitstatus_query only exists if the plugin loaded above, so we skip the hook when it didn't.
autoload -Uz add-zsh-hook
if (( ${+functions[gitstatus_query]} )); then
	add-zsh-hook precmd git_prompt_update
fi
# }}}

local vi_normal_marker="[%{$fg[magenta]%}N%{$reset_color%}]"
local vi_insert_marker="[%{$fg[cyan]%}I%{$reset_color%}]"
local vi_unknown_marker="[%{$fg[red]%}U%{$reset_color%}]"
local vi_mode="$vi_insert_marker"
vi_mode_indicator () {
case ${KEYMAP} in
	(vicmd)      echo $vi_normal_marker ;;
	(main|viins) echo $vi_insert_marker ;;
	(*)          echo $vi_unknown_marker ;;
esac
}

# Reset mode-marker and prompt whenever the keymap changes
function zle-line-init zle-keymap-select {
	vi_mode="$(vi_mode_indicator)"
	zle reset-prompt
}
zle -N zle-line-init
zle -N zle-keymap-select

# The above works fine for most things, however, it doesn't seem to reset the prompt to insert mode after a SIGINT
# CTRL+C action. So we need the following to reset the indicator to the insert marker. See the comments in the following
# article for more information: http://paulgoscicki.com/archives/2012/09/vi-mode-indicator-in-zsh-prompt/
function TRAPINT() {
	vi_mode="${vi_insert_marker}"
	#zle && zle reset-prompt
	return $(( 128 + $1 ))
}

# You can see what colors are available via: ~/scratch/colortest
dir_info_prompt() {
	print -P '${SSH_CONNECTION+"%{$fg_bold[green]%}%n@%M:"}%{$fg_bold[blue]%}%~%{$reset_color%}'
}
rel_info_prompt() {
	if [[ -e /etc/gaikai-release && ( -n "${SSH_CLIENT}" || -n "${SSH_TTY}" ) ]]; then
		print -P ' (%{$fg_bold[magenta]%}$(cat /etc/gaikai-release)%{$reset_color%})'
	fi
}
time_info_prompt() {
	print -P ' (%F{33}$(TZ="America/Chicago" date "+%D %T")%{$reset_color%})'
}
kubectl_info_prompt() {
	if command -v kubectl &> /dev/null; then
		local kubectl_contexts
		kubectl_context="$(kubectl config current-context 2>/dev/null)"
		if [[ -n "${kubectl_context}" ]]; then
			kubeconfig_override=""
			if [[ -n "${KUBECONFIG}" ]]; then
				kubeconfig_override="$(basename "${KUBECONFIG}") - "
			fi
			print -P ' (%B%F{22}${kubeconfig_override}${kubectl_context}%{$reset_color%})'
		fi
	fi
}
aws_info_prompt() {
	local tmp_aws_p tmp_aws_r
	if [[ -z "${AWS_DEFAULT_PROFILE}" && -z "${AWS_PROFILE}" ]]; then
		return 0
	fi
	tmp_aws_p="${AWS_PROFILE:-${AWS_DEFAULT_PROFILE}}"
	if [[ -e "${HOME}/.aws/config" ]]; then
		tmp_aws_r="$(awk -v tmp_aws_p="profile ${tmp_aws_p}" \
			'$0 ~ tmp_aws_p {do {if (getline == 0) exit 1; if ($0 ~ /^\[/) exit 1} while($1 != "region"); print $3; exit 0}' \
			~/.aws/config)"
	fi
	if [[ "${tmp_aws_p}" == *-zz-* ]]; then
		tmp_aws_p="$(cut -d'-' -f 4,5,7- <<<"${tmp_aws_p}")"
	fi
	printf ' (%s%s%s' "$(tput setaf 124)" "${tmp_aws_p}" "%{$reset_color%}"
	if [[ -n "${tmp_aws_r}" ]]; then
		printf ' - %s%s%s)' "$(tput setaf 027)" "${tmp_aws_r}" "%{$reset_color%}"
	else
		printf ')'
	fi
}
export PROMPT='$(dir_info_prompt)$(kubectl_info_prompt)$(aws_info_prompt)$(rel_info_prompt)$(time_info_prompt) ${GIT_PROMPT_STATUS}
[$[HISTCMD]]%(?.%{$fg[green]%}[0].%{$fg[red]%}[%?])%{$reset_color%}${vi_mode}%# '
# }}}

# Key and Termcap Settings {{{
# Disable SGR escape sequences as some terminals don't support it for rendering man pages
export GROFF_NO_SGR=1

# The following fixes the rest of the problems I've had showing colors in man pages with less as the pager
# source: https://linuxtidbits.wordpress.com/2009/03/23/less-colors-for-man-pages/
man() {
	env LESS_TERMCAP_mb=$'\E[01;31m' \
	LESS_TERMCAP_md=$'\E[01;38;5;74m' \
	LESS_TERMCAP_me=$'\E[0m' \
	LESS_TERMCAP_se=$'\E[0m' \
	LESS_TERMCAP_so=$'\E[38;5;246m' \
	LESS_TERMCAP_ue=$'\E[0m' \
	LESS_TERMCAP_us=$'\E[04;38;5;146m' \
	man "$@"
}

# Everything below this point to the end of section comes from: http://zshwiki.org/home/zle/bindkeys#reading_terminfo
# Create a zkbd compatible hash... to add other keys to this hash, see: man 5 terminfo
typeset -A key

key[Home]=${terminfo[khome]}
key[End]=${terminfo[kend]}
key[Insert]=${terminfo[kich1]}
key[Delete]=${terminfo[kdch1]}
key[Up]=${terminfo[kcuu1]}
key[Down]=${terminfo[kcud1]}
key[Left]=${terminfo[kcub1]}
key[Right]=${terminfo[kcuf1]}
key[PageUp]=${terminfo[kpp]}
key[PageDown]=${terminfo[knp]}
key[Backspace]=${terminfo[kbs]}

# Setup key accordingly
[[ -n "${key[Home]}"      ]]  && bindkey           "${key[Home]}"        beginning-of-line
[[ -n "${key[End]}"       ]]  && bindkey           "${key[End]}"         end-of-line
[[ -n "${key[Insert]}"    ]]  && bindkey           "${key[Insert]}"      overwrite-mode
[[ -n "${key[Delete]}"    ]]  && bindkey           "${key[Delete]}"      delete-char
[[ -n "${key[Up]}"        ]]  && bindkey           "${key[Up]}"          up-line-or-history
[[ -n "${key[Down]}"      ]]  && bindkey           "${key[Down]}"        down-line-or-history
[[ -n "${key[Left]}"      ]]  && bindkey           "${key[Left]}"        backward-char
[[ -n "${key[Right]}"     ]]  && bindkey           "${key[Right]}"       forward-char
[[ -n "${key[Backspace]}" ]]  && bindkey  -M viins "${key[Backspace]}"   backward-delete-char

# Finally, make sure the terminal is in application mode, when zle is active.
# Only then are the values from $terminfo valid.
function zle-line-init () {
	if [[ -n ${terminfo[smkx]} ]]; then
		echoti smkx
	fi
}
function zle-line-finish () {
	if [[ -n ${terminfo[rmkx]} ]]; then
		echoti rmkx
	fi
}
zle -N zle-line-init
zle -N zle-line-finish
# }}}

# Custom Key Bindings and Shortcuts {{{
# Enter VI mode with jj
bindkey jj vi-cmd-mode

# Switch to incremental pattern search, plus ability to go forward and backward
bindkey -M viins '^R' history-incremental-pattern-search-backward
bindkey -M vicmd '/' history-incremental-pattern-search-backward
bindkey -M isearch '^R' history-incremental-search-backward
bindkey -M isearch '^F' history-incremental-search-forward

# re-sets yank and kill shortcuts to bash/emacs mode
bindkey -M viins '^P' push-line-or-edit
bindkey -M viins '^Y' yank
# In order to use the below you must first yank without hitting enter, then subsequent alt-y combos will cycle through
# kill ring
bindkey -M viins '\ey' yank-pop
bindkey -M viins '^U' backward-kill-line

# sets ctrl+b and ctrl+f to forward and backword by word
bindkey -M viins '^G' vi-forward-blank-word
bindkey -M viins '^F' vi-backward-blank-word
bindkey -M viins '^J' vi-beginning-of-line
bindkey -M viins '^K' vi-end-of-line
# }}}

# Local Functions (tmux_info, gitcm, load_colors, ff, fe) {{{

# }}}

# Additional File Sourcing (.zshrc.user.local & .function.local) {{{
# Source misc functions
if [[ -e "${HOME}/.functions.local" ]]; then
	source "${HOME}/.functions.local"
fi

# Add additional zsh functions not in git
if [[ -e "${HOME}/.zshrc.user.local" ]]; then
	source "${HOME}/.zshrc.user.local"
fi
# }}}

# Path Additions, Language Setup, and Cleanup {{{
# Include additional paths for cheat
export CHEATPATH="$CHEATPATH:/home/auren/.cheat.local"

# SSH Agent Setup {{{

# Check to make sure an SSH agent is running, if not attempt to start one (see: ~/.functions.local)
setup_ssh_agent

# Ensure that SSH agent is setup to add keys to agent and to use keychain on mac (see: ~/.functions.local)
initialize_ssh_config

# }}}

# Golang {{{
# Add GOPATH env variable
export GOPATH=${HOME}/go-workspace

# Add bin directory from GOPATH to the PATH for executables
[[ -d "${GOPATH}" && -d "${GOPATH}/bin" ]] && PATH="${GOPATH}/bin:${PATH}"

# If GOROOT doesn't exist, but /usr/local/go/bin does, then put that in the path
if [[ -z "${GOROOT}" && -d "/usr/local/go/bin" ]]; then
	PATH="/usr/local/go/bin:${PATH}"
fi
# }}}

# Ruby {{{
# Add ruby gem bin directory
if [[ -d "${HOME}/.gem/ruby" ]]; then
	for ruby_ver in "${HOME}/.gem/ruby/"*; do
		[[ -d "${ruby_ver}" && -d "${ruby_ver}/bin" ]] && PATH="${ruby_ver}/bin:${PATH}"
	done
fi
if [[ -d "${HOME}/.rbenv/bin" ]]; then
	PATH="$HOME/.rbenv/bin:$PATH"
fi
# }}}

# pyenv {{{
# Add and source pyenv (python version manager) if it exists
for iDir in "${HOME}/thirdparty-git/pyenv" "${HOME}/.pyenv"; do
	if [[ -d "${iDir}" ]]; then
		PYENV_DIR="${iDir}"
		if [[ -e "${PYENV_DIR}/bin/pyenv" ]]; then
			PATH="${PYENV_DIR}/bin:${PATH}"
			eval "$(pyenv init - --no-rehash)"
		fi
		# Add and source pyenv-virtualenv plugin (integrates with pyenv version manager) if it exists (don't run on OSX
		# as it takes forever for prompts to appear when this is the case.
		if [[ -d "${PYENV_DIR}/plugins/pyenv-virtualenv" && "${OSTYPE}" != *"darwin"* ]]; then
			eval "$(pyenv virtualenv-init -)"
		fi
	fi
done
# }}}

# Rust {{{
# Add Rust bin directory
if [[ -d "${HOME}/.cargo/bin" ]]; then
	PATH="${HOME}/.cargo/bin:${PATH}"
fi
# }}}

# Add local bin file
if [[ -e "${HOME}/bin" ]]; then
	PATH="${HOME}/bin:${PATH}"
fi

if [[ -e "${HOME}/desktop_bin" ]]; then
	PATH="${HOME}/desktop_bin:${PATH}"
fi

# Brew {{{
# If this is a Mac we'll add some more stuff
if [[ "${OSTYPE}" == *"darwin"* ]]; then
	if [[ -d "/usr/local/opt/coreutils/libexec/gnubin" ]]; then
		PATH="/usr/local/opt/coreutils/libexec/gnubin:${PATH}"
	fi
	if [[ -d "/opt/homebrew/bin" ]]; then
		PATH="/opt/homebrew/bin:${PATH}"
	fi
	if command -v brew &>/dev/null; then
		if brew_prefix="$(brew --prefix golang)"; then
			if [[ -d "${brew_prefix}" ]]; then
				export GOROOT="${brew_prefix}/libexec"
				PATH="${brew_prefix}/bin:${PATH}"
			fi
		fi
	fi
fi
# }}}

# Node {{{
# Add node bin directory
[[ -d "${HOME}/node_modules" && -d "${HOME}/node_modules/.bin" ]] && PATH="${HOME}/node_modules/.bin:${PATH}"

# Add and source nvm (node version manager) if it exists
if [[ -d "${HOME}/thirdparty-git/nvm" ]]; then
	export NVM_DIR="${HOME}/thirdparty-git/nvm"

	if [[ -s "${NVM_DIR}/nvm.sh" ]]; then
		# We need to turn off extended glob before running nvm scripts for performance, we return it at the bottom
		# afterwards
		_nvm_extendedglob_was_on="${options[extendedglob]}"

		unsetopt extendedglob
		# This enables nvm based commands like nvm_strip_path and the like without selecting a node version which is
		# more overhead and delays a shell on some slower systems
		source "${NVM_DIR}/nvm.sh" --no-use

		# Remove an inherited NVM version before selecting the default directly.
		PATH="$(nvm_strip_path "${PATH}")"

		_nvm_default_version="$(<"${NVM_DIR}/alias/default")"
		_nvm_default_root="${NVM_DIR}/versions/node/${_nvm_default_version}"

		# Instead of using nvm to do this, we derrive the node version ourselves and add it to our path to improve
		# performance. bash completion is handled after compinit (See completion setup).
		if [[ -x "${_nvm_default_root}/bin/node" ]]; then
			export NVM_BIN="${_nvm_default_root}/bin"
			export NVM_INC="${_nvm_default_root}/include/node"
			PATH="${NVM_BIN}:${PATH}"
		fi

		# Preserve your workaround for NVM and extendedglob.
		functions[_nvm_without_extendedglob]="${functions[nvm]}"
		nvm() {
			setopt localoptions noextendedglob
			_nvm_without_extendedglob "$@"
		}

		[[ "${_nvm_extendedglob_was_on}" == on ]] && setopt extendedglob

		unset _nvm_extendedglob_was_on
		unset _nvm_default_version
		unset _nvm_default_root
	fi
fi
# }}}

if [[ -e "${HOME}/binMan" ]]; then
	PATH="${HOME}/binMan:${PATH}"
fi

if [[ -e "${HOME}/.local/bin" ]]; then
	PATH="${HOME}/.local/bin:${PATH}"
fi

# Remove duplicate PATH entries while preserving the first occurrence.
typeset -U path PATH

# Place /usr/sbin immediately before /usr/bin.
if (( ${path[(I)/usr/sbin]} && ${path[(I)/usr/bin]} )); then
	path=(${path:#/usr/sbin})
	path[${path[(i)/usr/bin]}]=(/usr/sbin /usr/bin)
fi

# Place /sbin immediately before /bin.
if (( ${path[(I)/sbin]} && ${path[(I)/bin]} )); then
	path=(${path:#/sbin})
	path[${path[(i)/bin]}]=(/sbin /bin)
fi

# }}}

# Completion Setup {{{

# load our own completion functions
fpath=(~/.zsh/completion /usr/local/share/zsh/site-functions $fpath)

### Automatically generate zsh completion files if the executable is newer than the completion file (this reduces
### startup time by not shelling out to the executables each time the shell inits and instead relying on completion
### functions in the fpath
### Call with: _refresh_zsh_completion <executable> <fpath_output_file_name> [<params> <sent> <to> <executable>]
_refresh_zsh_completion() {
	local command_name="$1"
	local output="$2"
	local executable="${commands[$command_name]}"
	local temporary

	shift 2

	[[ -n "$executable" ]] || return 0

	# Keep the existing completion unless the executable is newer.
	if [[ -s "$output" ]] && [[ ! "$executable" -nt "$output" ]]; then
		return 0
	fi

	temporary="${output}.tmp.$$"

	if "$executable" "$@" >| "$temporary" && [[ -s "$temporary" ]]; then
		command mv -f -- "$temporary" "$output"
	else
		command rm -f -- "$temporary"
		print -u2 "Unable to regenerate completion for ${command_name}"
		return 1
	fi
}

# Check and generate kind fpath completions
_refresh_zsh_completion kind "${fpath[1]}/_kind" completion zsh

# Check and generate kubectl fpath completions
_refresh_zsh_completion kubectl "${fpath[1]}/_kubectl" completion zsh

# Check and generate helm fpath completions
_refresh_zsh_completion helm "${fpath[1]}/_helm" completion zsh

unfunction _refresh_zsh_completion

# Write out completions for tldr to our current completion directory
if type tldr > /dev/null; then
	tldr --zsh-completion | sed 's/\[\[//' > "${fpath[1]}/_tldr"
fi

# Mark bashcompinit and compinit as functions and override any similarly named commands that exist in PATH
autoload bashcompinit
autoload -Uz compinit

# All modifications to FPATH need to be done BEFORE the following two commands. Specifically compinit seems to walk all
# directories in FPATH and create the completion for them.

# Provides compatibility with the bash compinit functions (like compgen & complete)
bashcompinit
# Provides zsh completion functions (-u here tells compinit to not warn on directories not owned by current user)
compinit -u

# Things that load their completion using source (which is discouraged) need to be loaded AFTER compinit or we get # errors
# Additionally, many things run compinit if it hasn't already run as a safe-guard, so this keeps compinit from running
# twice.

# NVM Completions
if [[ -s "${NVM_DIR}/bash_completion" ]]; then
	source "${NVM_DIR}/bash_completion" # works for both bash and zsh despite the name
fi

# AWS completions
if [[ -n "${commands[aws_completer]}" ]]; then
	complete -C "${commands[aws_completer]}" aws
fi

# This seems to need to be run last
# Adds in compdef entrypoints for custom k8s k* functions as defined in .functions.local
compdef __k_comp_entrypoint "${K8S_FUNCS[@]}"
# }}}

# Add fasd directory jumper {{{
# Adds fasd (directory hopper) to the command line
# By default FASD uses the ~/.fasd file. This makes it backwards compatible with the .z history I've already built.
export _FASD_DATA="${HOME}/.z"
# This export is needed in order to ensure that z still works under sudo
export _FASD_OWNER="${SUDO_USER:-${USER}}"
# Increase the maximum history that is kept
export _FASD_MAX="99999"

# This needs to be below the ~/bin PATH addition above or it will not work
eval "$(${HOME}/bin/fasd --init auto)"
# }}}

# Search history with peco <ALT+r> (needs to be below path declaration) {{{
# Search shell history with peco: https://github.com/peco/peco
if which peco &> /dev/null; then
	function peco_select_history() {
		local tac
		{ which gtac &> /dev/null && tac="gtac" } || { which tac &> /dev/null && tac="tac" } || tac="tail -r"
		BUFFER=$(fc -l -n 1 | eval $tac | peco --query "$LBUFFER")
		CURSOR=$#BUFFER # move cursor
		zle -R -c # refresh
	}

	zle -N peco_select_history
	bindkey '\er' peco_select_history
fi
# }}}

