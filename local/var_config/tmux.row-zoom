#!/bin/sh

active_pane=${1:-$(tmux display-message -p '#{pane_id}')}
window=$(tmux display-message -p -t "$active_pane" '#{window_id}')

saved_layout=$(tmux show-options -wqv -t "$window" @row_zoom_layout)

if [ -n "$saved_layout" ]; then
    tmux select-layout -t "$window" "$saved_layout"

    saved_pane=$(tmux show-options -wqv -t "$window" @row_zoom_pane)
    if [ -n "$saved_pane" ]; then
        tmux select-pane -t "$saved_pane"
    fi

    tmux set-option -wu -t "$window" @row_zoom_layout
    tmux set-option -wu -t "$window" @row_zoom_pane
    exit
fi

layout=$(tmux display-message -p -t "$active_pane" '#{window_layout}')
active_top=$(tmux display-message -p -t "$active_pane" '#{pane_top}')
active_height=$(tmux display-message -p -t "$active_pane" '#{pane_height}')

tmux set-option -wq -t "$window" @row_zoom_layout "$layout"
tmux set-option -wq -t "$window" @row_zoom_pane "$active_pane"

tmux list-panes -t "$window" -F '#{pane_id} #{pane_top} #{pane_height}' |
while read -r pane top height; do
    # Panes with the same vertical bounds belong to the active row
    if [ "$top" != "$active_top" ] || [ "$height" != "$active_height" ]; then
        tmux resize-pane -t "$pane" -y 1
    fi
done
